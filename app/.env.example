# DriveLocal frontend configuration (Vite).
# Copy to .env (or .env.local) for local development; on Vercel/Render set the
# same variables as project environment variables.
#
# NOTE: Vite inlines these at BUILD time. On a static host you must set them and
# then rebuild/redeploy for the change to take effect.

# The API origin when the backend is hosted separately (split deployment).
# Example: https://drivelocal-api.onrender.com
# Leave empty when the SPA and the API are served from the same origin
# (one-host deploy behind a reverse proxy) — then requests go to /api/…
VITE_API_BASE=

# The platform owner's phone (E.164). Used for the support/WhatsApp contact
# and to recognise the admin (owner) account in the UI.
VITE_DRIVER_PHONE=+27000000000
