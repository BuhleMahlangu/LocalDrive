# DriveLocal backend configuration
# Copy to .env and fill in real values for production.

# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES=30d
# The platform owner's phone in E.164 format. This account is the admin owner
# (and driver). Everyone else who picks "I'm the driver" submits an
# application that the owner approves/rejects from the Admin tab.
DRIVER_PHONE=+27000000000

# Optional: persist OTP/IP rate limits in SQLite (shared across processes and restarts).
# RATE_LIMIT_PERSIST=true

# OTP delivery via email (Nodemailer + SMTP). When SMTP_HOST/SMTP_USER/SMTP_PASS
# are set, a real random code is emailed to the requesting user (their stored
# or supplied address). Without them, the interim fixed code 123456 is used and
# logged to the server console (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DriveLocal <no-reply@drivelocal.co.za>
# SMTP_REPLY_TO=

# Real SMS OTP delivery (strongly recommended for production). Set SMS_PROVIDER
# to one of: africastalking | twilio | clicksend, plus that provider's keys.
# When configured, OTP codes are random per request and sent by SMS; without it
# the app falls back to email OTP (SMTP above) or the interim fixed code 123456.
# In development, SMS are logged to the console instead of sent (no credit
# burned) — set SMS_FORCE=true to send for real from a dev machine.
# SMS_PROVIDER=africastalking
# AT_API_KEY=
# AT_USERNAME=          # your AT app username ('sandbox' for the sandbox)
# AT_SENDER_ID=         # optional registered sender ID / short code
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=          # e.g. +15005550006 (Twilio test) or your SA number
# SMS_PROVIDER=clicksend
# CLICKSEND_USERNAME=
# CLICKSEND_API_KEY=
# CLICKSEND_FROM=       # optional sender ID (SMS_FROM is accepted as an alias)
# SMS_SEND_IN_DEV=true
# Escape hatch for a closed/private beta: run with the fixed 123456 code in
# production even though no OTP delivery path is configured.
# ALLOW_FIXED_OTP=true

# Yoco (SA card payments, hosted checkout). Key format: sk_test_... / sk_live_...
# 1. In the Yoco dashboard (Sales > Payment Gateway > Settings) register a webhook
#    pointing at:  https://<your-host>/api/payments/webhook  (endpoint registered)
# 2. Copy the secret key + webhook secret (whsec_...) from that page into here.
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=
# Where Yoco redirects after payment (hosted checkout). Must be a URL you control
# AND a verified domain in your Yoco account.
YOCO_SUCCESS_URL=http://localhost:5173/?payment=success
YOCO_CANCEL_URL=http://localhost:5173/?payment=cancelled
# Verify once keys are set: GET /api/payments/config -> { "enabled": true }
# Commission taken from each card trip AFTER Yoco's fee, e.g. 10 = 10%
# (on cash trips the amount is tracked and owed to the platform).
PLATFORM_FEE_PERCENT=10

# Currency (Rand/ZAR for South Africa). Display symbol handled in the client.
CURRENCY=zar

# Database
# When DB_DRIVER=sqlite (default for local dev), a local file in ./data is used.
# When DB_DRIVER=postgres, DATABASE_URL is used and PostGIS must be enabled.
DB_DRIVER=sqlite
DATABASE_URL=postgres://user:pass@localhost:5432/drivelocal
# Optional: point tests/backups at another sqlite file, e.g. DB_FILE=:memory:
# DB_FILE=
# Optional: where driver vetting documents are stored. Deployments with a
# persistent volume (e.g. Railway mounting /data) should set this so document
# uploads survive redeploys. Default: ./data/uploads
# UPLOADS_DIR=

# Encryption key for stored driver bank-account numbers (optional but strongly
# recommended in production; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# When unset, account numbers are stored as plaintext (dev convenience only).
BANK_DETAILS_KEY=

# Payout webhook secret (HMAC sha256) used to verify provider/bank callbacks at
# POST /api/payouts/webhook. When set, requests must carry header
# X-Payout-Webhook-Signature. Leave empty in dev to allow unsigned calls.
PAYOUT_WEBHOOK_SECRET=

# Maps (Google Directions API key - used for route/ETA + polylines)
GOOGLE_MAPS_API_KEY=

# Web Push (VAPID keys). Generate your own with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:driver@drivelocal.co.za

# CORS allowlist (comma separated origins)
CORS_ORIGINS=http://localhost:5173

# Backups (docker `backup` service / backup-loop): how often (hours) and how
# many local copies to keep. Off-site copy: set the BACKUP_S3_* vars to any
# S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO...). If left
# blank, backups stay local-only.
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=14
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=drivelocal
